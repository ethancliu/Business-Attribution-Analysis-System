# ============================================================================
# 经营多轮归因分析系统 —— 后端基础设施配置示例
#
# 用法：复制为 .env 后按实际环境修改。
# 注意：这里的配置是**进程级**的，改完要重启服务；
#       业务配置（可热更新）存在数据库 system_configs 表，改完调 /api/admin/reload 即可。
# ============================================================================

# ---- 服务 ----
APP_NAME=经营多轮归因分析系统
APP_VERSION=1.0.0
HOST=0.0.0.0
PORT=8000
DEBUG=true
# 后端对外可达地址（用于拼回调地址）
PUBLIC_BASE_URL=http://localhost:8000
# 前端地址（登录回调完成后跳转到此）
FRONTEND_BASE_URL=http://localhost:5173

# ---- 业务数据库 ----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=analysis_sys
DB_CHARSET=utf8mb4

# ---- 认证中心（独立服务，默认 9000 端口）----
AUTH_BASE_URL=http://localhost:9000
AUTH_CLIENT_ID=jingying-web
AUTH_CLIENT_SECRET=jingying-web-secret-2026
AUTH_REDIRECT_URI=http://localhost:8000/auth/callback
AUTH_SCOPE=openid profile analysis
# 令牌内省结果缓存秒数（越小越安全，越大对认证中心压力越小）
AUTH_INTROSPECT_CACHE_SEC=60
AUTH_HTTP_TIMEOUT_SEC=10
# 认证中心未返回 expires_in 时的兜底有效期
AUTH_TOKEN_TTL_HINT=7200

# ---- 文件存储根目录（相对 backend/，也可写绝对路径）----
DATA_DIR=data

# ---- CORS（逗号分隔）----
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000,http://localhost:4173,http://127.0.0.1:4173

# ---- Cookie ----
COOKIE_NAME=jy_access_token
REFRESH_COOKIE_NAME=jy_refresh_token
# 生产环境走 HTTPS 时必须改为 true
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
