# 认证中心配置模板
# 复制为 .env 后按需修改；不创建 .env 时全部走 app/core/config.py 中的默认值。

# ---- 服务 ----
HOST=127.0.0.1
PORT=9000
DEBUG=true

# ---- 数据库（认证域，与业务库分开） ----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=analysis_auth
DB_CHARSET=utf8mb4

# ---- 令牌策略（秒） ----
AUTH_CODE_TTL_SEC=300
ACCESS_TOKEN_TTL_SEC=7200
REFRESH_TOKEN_TTL_SEC=604800
SESSION_TTL_SEC=43200

# ---- 自管理接口鉴权头 X-Admin-Key ----
ADMIN_API_KEY=jingying-auth-admin-2026

# ---- CORS，多个来源用英文逗号分隔 ----
CORS_ORIGINS=*
